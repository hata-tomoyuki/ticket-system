<Project>

  <!--
    ソリューション配下の全 .csproj に自動で読み込まれる。
    個々の csproj に同じ 3 行を書かなくて済み、
    「全プロジェクトで同じ設定になっている」ことがこの 1 ファイルで保証される。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
